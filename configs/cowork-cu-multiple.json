{
  "driver": "cowork_cu",
  "queries": [
    "Replace this with the first Cowork task.",
    "Replace this with the second Cowork task."
  ],
  "timeoutMs": 120000,
  "servers": [
    {
      "transport": "http",
      "label": "glean-eval",
      "serverUrl": "https://scio-prod-be.glean.com/mcp/default/eval",
      "auth": {
        "accessTokenEnv": "GLEAN_API_TOKEN"
      }
    }
  ],
  "coworkSetup": {
    "approveWriteTools": true
  },
  "options": {
    "computerUseProvider": "anthropic-computer-use"
  }
}
