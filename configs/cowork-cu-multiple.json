{
  "driver": "cowork_cu",
  "queries": ["Who is my manager?", "What team do I work on?"],
  "timeoutMs": 120000,
  "servers": [
    {
      "transport": "http",
      "label": "glean-eval",
      "serverUrl": "https://scio-prod-be.glean.com/mcp/default/eval",
      "auth": {
        "accessTokenEnv": "GLEAN_API_TOKEN"
      }
    }
  ],
  "coworkSetup": {
    "approveWriteTools": true
  },
  "options": {
    "computerUseProvider": "anthropic-computer-use",
    "computerUseMaxActions": 36
  }
}
