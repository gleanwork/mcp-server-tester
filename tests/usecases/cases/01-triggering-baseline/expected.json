{
  "title": "Improve tool triggering over time: one server, one host, compared with the previous run",
  "runs": 2,
  "exitCode": 1,
  "exitCodes": [0, 1],
  "checks": [
    {
      "path": "metrics.passRate",
      "equals": 0.5
    },
    {
      "path": "arms[name=default].metrics.passed_rate",
      "equals": 0.5
    },
    {
      "path": "arms[name=default].metrics.trial_pass_rate",
      "equals": 0.8
    },
    {
      "path": "previousRun",
      "exists": true
    },
    {
      "path": "previousRun.passRateDelta",
      "equals": -0.5
    },
    {
      "path": "arms[name=default].result.caseResults[0].iterationResults.length",
      "equals": 10
    },
    {
      "path": "arms[name=default].result.caseResults[0].iterationResults[0].trace.events[0].server",
      "equals": "agg"
    },
    {
      "path": "arms[name=default].result.caseResults[0].trace",
      "exists": false
    },
    {
      "path": "previousRun.sameManifest",
      "equals": true
    },
    {
      "path": "previousRun.arms.default.regressed",
      "equals": ["billing-owner"]
    },
    {
      "path": "previousRun.arms.default.improved",
      "equals": []
    },
    {
      "path": "previousRun.arms.default.trialPassRateDelta",
      "equals": -0.1
    }
  ],
  "ledger": {
    "metrics": ["input_tokens_mean", "output_tokens_mean", "tool_count_mean"]
  }
}
