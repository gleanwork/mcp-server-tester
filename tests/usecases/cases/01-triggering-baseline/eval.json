{
  "name": "triggering-baseline",
  "datasets": ["./dataset.json"],
  "servers": ["{{server aggregate agg}}"],
  "client": "usecase/client/model",
  "clientOptions": {
    "policy": [
      {
        "when": {
          "input": "planning"
        },
        "steps": [
          {
            "call": {
              "name": "search"
            },
            "args": {
              "query": "planning"
            }
          }
        ]
      },
      {
        "when": {
          "input": "billing",
          "run": 1
        },
        "steps": [
          {
            "call": {
              "name": "search"
            },
            "args": {
              "query": "billing owner"
            },
            "rate": 0.6
          }
        ]
      },
      {
        "when": {
          "input": "billing"
        },
        "steps": [
          {
            "call": {
              "name": "search"
            },
            "args": {
              "query": "billing owner"
            },
            "rate": 0.8
          }
        ]
      }
    ]
  },
  "run": {
    "trials": 10,
    "passThreshold": 0.8
  },
  "metrics": [
    "passed",
    "tool_count",
    "input_tokens",
    "output_tokens",
    "cost_usd"
  ],
  "results": {
    "store": {
      "type": "file",
      "dir": "./store"
    }
  }
}
