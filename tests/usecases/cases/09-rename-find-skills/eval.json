{
  "name": "find-skills-rename",
  "datasets": ["./dataset.json"],
  "servers": ["{{server aggregate agg}}"],
  "client": "usecase/client/model",
  "clientOptions": {
    "policy": [
      {
        "steps": [
          {
            "call": {
              "nameIncludes": "tools"
            },
            "args": {
              "query": "create ticket"
            }
          }
        ]
      }
    ]
  },
  "metrics": [
    "passed",
    "tool_count",
    "input_tokens",
    "output_tokens",
    "cost_usd"
  ],
  "variants": [
    {
      "name": "baseline"
    },
    {
      "name": "renamed",
      "tools": {
        "find_skills": {
          "name": "find_more_skills_and_tools"
        }
      }
    }
  ]
}
