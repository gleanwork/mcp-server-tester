{
  "name": "find-skills-rename",
  "datasets": ["./dataset.json"],
  "servers": ["{{server aggregate agg}}"],
  "host": {
    "type": "usecase/model",
    "policy": [
      {
        "steps": [
          {
            "call": {
              "nameIncludes": "tools"
            },
            "args": {
              "query": "create ticket"
            }
          }
        ]
      }
    ]
  },
  "metrics": [
    "passed",
    "tool_count",
    "input_tokens",
    "output_tokens",
    "cost_usd"
  ],
  "arms": [
    {
      "name": "baseline"
    },
    {
      "name": "renamed",
      "toolOverrides": {
        "id": "renamed",
        "tools": {
          "find_skills": {
            "name": "find_more_skills_and_tools"
          }
        }
      },
      "toolMap": {
        "find_skills": ["agg.find_more_skills_and_tools"]
      }
    }
  ]
}
