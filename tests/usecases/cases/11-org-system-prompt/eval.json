{
  "name": "find-skills-org-prompt",
  "datasets": ["./dataset.json"],
  "servers": ["{{server aggregate agg}}"],
  "client": "usecase/model",
  "clientOptions": {
    "policy": [
      {
        "when": {
          "instruction": "call find_skills first"
        },
        "steps": [
          {
            "call": {
              "name": "find_skills"
            },
            "args": {
              "query": "create ticket"
            }
          },
          {
            "call": {
              "name": "search"
            },
            "args": {
              "query": "checkout outage"
            }
          }
        ]
      },
      {
        "steps": [
          {
            "call": {
              "name": "search"
            },
            "args": {
              "query": "checkout outage"
            }
          }
        ]
      }
    ]
  },
  "metrics": [
    "passed",
    "tool_count",
    "input_tokens",
    "output_tokens",
    "cost_usd"
  ],
  "variants": [
    {
      "name": "no-prompt"
    },
    {
      "name": "org-prompt",
      "clientOptions": {
        "systemPrompt": "For any action in a connected app (tracker, chat, mail), call find_skills first and use the tools it returns."
      }
    }
  ]
}
