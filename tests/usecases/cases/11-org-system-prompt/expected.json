{
  "title": "An organisation-wide system prompt steers the host to find_skills",
  "exitCode": 1,
  "checks": [
    {
      "path": "variants[name=no-prompt].metrics.passed_rate",
      "equals": 0
    },
    {
      "path": "variants[name=org-prompt].metrics.passed_rate",
      "equals": 1
    },
    {
      "path": "variantDeltas.org-prompt.passRateDelta",
      "equals": 1
    }
  ],
  "ledger": {
    "metrics": ["input_tokens_mean", "output_tokens_mean", "tool_count_mean"]
  }
}
