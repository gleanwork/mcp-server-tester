{
  "name": "guidance-plugin-effect",
  "datasets": ["./dataset.json"],
  "servers": {
    "docs": "{{server docs}}"
  },
  "client": "usecase/client/model",
  "clientOptions": {
    "policy": [
      {
        "when": {
          "plugin": "tool-guidance"
        },
        "steps": [
          {
            "call": {
              "name": "search"
            },
            "args": {
              "query": "Q3 planning"
            }
          }
        ]
      },
      {
        "steps": [
          {
            "call": {
              "name": "search"
            },
            "args": {
              "query": "Q3 planning"
            },
            "rate": 0.4
          }
        ]
      }
    ]
  },
  "trials": 10,
  "metrics": [
    "passed",
    "tool_count",
    "input_tokens",
    "output_tokens",
    "cost_usd"
  ],
  "variants": [
    {
      "name": "descriptions-only"
    },
    {
      "name": "with-guidance",
      "clientOptions": {
        "plugins": ["tool-guidance"]
      }
    }
  ]
}
