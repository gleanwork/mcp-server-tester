{
  "name": "description-variants",
  "datasets": ["./dataset.json"],
  "servers": {
    "docs": "{{server docs}}"
  },
  "client": "usecase/client/model",
  "clientOptions": {
    "policy": [
      {
        "steps": [
          {
            "call": {
              "description": "postmortems"
            },
            "args": {
              "query": "checkout outage"
            }
          }
        ]
      }
    ]
  },
  "metrics": [
    "passed",
    "tool_count",
    "input_tokens",
    "output_tokens",
    "cost_usd"
  ],
  "variants": [
    {
      "name": "baseline"
    },
    {
      "name": "concise",
      "tools": {
        "search": {
          "description": "Search docs."
        }
      }
    },
    {
      "name": "verbose",
      "tools": {
        "search": {
          "description": "Search documents by title and body: postmortems, runbooks and planning notes."
        }
      }
    }
  ]
}
