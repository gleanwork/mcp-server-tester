{
  "name": "description-variants",
  "datasets": ["./dataset.json"],
  "servers": ["{{server aggregate agg}}"],
  "host": {
    "type": "usecase/model",
    "policy": [
      {
        "steps": [
          {
            "call": {
              "description": "connected sources"
            },
            "args": {
              "query": "checkout outage"
            }
          }
        ]
      }
    ]
  },
  "metrics": [
    "passed",
    "tool_count",
    "input_tokens",
    "output_tokens",
    "cost_usd"
  ],
  "arms": [
    {
      "name": "baseline"
    },
    {
      "name": "concise",
      "toolOverrides": {
        "id": "concise",
        "tools": {
          "search": {
            "description": "Search company knowledge."
          }
        }
      }
    },
    {
      "name": "verbose",
      "toolOverrides": {
        "id": "verbose",
        "tools": {
          "search": {
            "description": "Search across all connected sources: documents, tickets, chat and mail."
          }
        }
      }
    }
  ]
}
