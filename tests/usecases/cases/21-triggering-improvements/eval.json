{
  "name": "triggering-improvements",
  "datasets": ["./dataset.json"],
  "servers": {
    "docs": "{{server docs}}",
    "github": "{{server github}}",
    "tracker": "{{server tracker}}",
    "chat": "{{server chat}}",
    "mail": "{{server mail}}"
  },
  "toolMap": {
    "docs_search": ["docs.search"]
  },
  "client": "usecase/client/model",
  "clientOptions": {
    "policy": [
      {
        "when": {
          "instruction": "search documents first"
        },
        "steps": [
          {
            "call": {
              "description": "documents"
            },
            "args": {
              "query": "postmortem"
            }
          }
        ]
      },
      {
        "when": {
          "plugin": "docs-plugin"
        },
        "steps": [
          {
            "call": {
              "description": "tickets"
            },
            "args": {
              "query": "postmortem"
            }
          },
          {
            "call": {
              "description": "documents"
            },
            "args": {
              "query": "postmortem"
            },
            "rate": 0.8
          }
        ]
      },
      {
        "steps": [
          {
            "call": {
              "description": "tickets"
            },
            "args": {
              "query": "postmortem"
            }
          },
          {
            "call": {
              "description": "documents"
            },
            "args": {
              "query": "postmortem"
            },
            "rate": 0.5
          }
        ]
      }
    ]
  },
  "trials": 10,
  "metrics": [
    "passed",
    "tool_count",
    "input_tokens",
    "output_tokens",
    "cost_usd"
  ],
  "variants": [
    {
      "name": "docs-mcp"
    },
    {
      "name": "docs-plugin",
      "clientOptions": {
        "plugins": ["docs-plugin"]
      }
    },
    {
      "name": "docs-mcp-org-instructions",
      "clientOptions": {
        "systemPrompt": "Search documents first for questions about past incidents."
      }
    }
  ]
}
