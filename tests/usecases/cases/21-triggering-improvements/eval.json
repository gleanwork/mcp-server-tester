{
  "name": "triggering-improvements",
  "datasets": ["./dataset.json"],
  "servers": [
    "{{server aggregate agg}}",
    "{{server github github}}",
    "{{server tracker tracker}}",
    "{{server chat chat}}",
    "{{server mail mail}}"
  ],
  "toolMap": {
    "company_search": ["agg.search"]
  },
  "client": "usecase/model",
  "clientOptions": {
    "policy": [
      {
        "when": {
          "instruction": "company search first"
        },
        "steps": [
          {
            "call": {
              "description": "company documents"
            },
            "args": {
              "query": "postmortem"
            }
          }
        ]
      },
      {
        "when": {
          "plugin": "aggregate-plugin"
        },
        "steps": [
          {
            "call": {
              "description": "tickets"
            },
            "args": {
              "query": "postmortem"
            }
          },
          {
            "call": {
              "description": "company documents"
            },
            "args": {
              "query": "postmortem"
            },
            "rate": 0.8
          }
        ]
      },
      {
        "steps": [
          {
            "call": {
              "description": "tickets"
            },
            "args": {
              "query": "postmortem"
            }
          },
          {
            "call": {
              "description": "company documents"
            },
            "args": {
              "query": "postmortem"
            },
            "rate": 0.5
          }
        ]
      }
    ]
  },
  "trials": 10,
  "metrics": [
    "passed",
    "tool_count",
    "input_tokens",
    "output_tokens",
    "cost_usd"
  ],
  "variants": [
    {
      "name": "aggregate-mcp"
    },
    {
      "name": "aggregate-plugin",
      "clientOptions": {
        "plugins": ["aggregate-plugin"]
      }
    },
    {
      "name": "aggregate-mcp-org-instructions",
      "clientOptions": {
        "systemPrompt": "Use company search first for company knowledge."
      }
    }
  ]
}
