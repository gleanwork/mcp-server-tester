              {
                "call": {
                  "name": "read_document"
                },
                "args": {
                  "id": "inc-482"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "cli",
      "servers": ["agg"],
      "client": "usecase/client/model",
      "clientOptions": {
        "policy": [
          {
            "steps": [
              {
                "call": {
                  "name": "search"
                },
                "args": {
                  "query": "checkout outage"
                }
              }
            ]
          }
        ]
      }
    }
  ]
