{
  "name": "find-skills-tool-search",
  "datasets": ["./dataset.json"],
  "servers": ["{{server aggregate agg}}"],
  "client": "usecase/client/model",
  "clientOptions": {
    "policy": [
      {
        "steps": [
          {
            "toolSearch": "create tracker ticket"
          },
          {
            "call": {
              "name": "find_skills"
            },
            "args": {
              "query": "create ticket"
            },
            "afterSearch": true
          }
        ]
      }
    ]
  },
  "metrics": [
    "passed",
    "tool_count",
    "input_tokens",
    "output_tokens",
    "cost_usd"
  ],
  "variants": [
    {
      "name": "baseline"
    },
    {
      "name": "description-v2",
      "tools": {
        "find_skills": {
          "description": "Find skills and tools for connected apps: create tracker tickets, post chat messages, share files."
        }
      }
    }
  ]
}
