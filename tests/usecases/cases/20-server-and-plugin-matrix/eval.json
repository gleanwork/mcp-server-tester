{
  "name": "variants-native-vs-aggregate",
  "datasets": ["./dataset.json"],
  "servers": {
    "github": "{{server github}}",
    "tracker": "{{server tracker}}",
    "chat": "{{server chat}}",
    "mail": "{{server mail}}",
    "agg": "{{server aggregate}}",
    "gateway": "{{server gateway}}"
  },
  "client": "usecase/client/model",
  "model": "claude-sonnet-4-5",
  "clientOptions": {
    "policy": [
      {
        "when": {
          "plugin": "aggregate-plugin"
        },
        "steps": [
          {
            "skill": "company-search"
          },
          {
            "call": {
              "nameIncludes": "search"
            },
            "args": {
              "query": "checkout outage"
            },
            "all": true
          }
        ]
      },
      {
        "steps": [
          {
            "call": {
              "nameIncludes": "search"
            },
            "args": {
              "query": "checkout outage"
            },
            "all": true
          },
          {
            "call": {
              "name": "read_document"
            },
            "args": {
              "id": "inc-482"
            }
          }
        ]
      }
    ]
  },
  "metrics": [
    "passed",
    "tool_count",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "judge_pass"
  ],
  "variants": [
    {
      "name": "native-connectors",
      "servers": ["github", "tracker", "chat", "mail"]
    },
    {
      "name": "aggregate-mcp-gateway",
      "servers": ["agg", "gateway"]
    },
    {
      "name": "aggregate-mcp-native-connectors",
      "servers": ["agg", "github", "tracker", "chat", "mail"]
    },
    {
      "name": "aggregate-plugin-gateway",
      "servers": ["agg", "gateway"],
      "clientOptions": {
        "plugins": ["aggregate-plugin"]
      }
    },
    {
      "name": "aggregate-plugin-native-connectors",
      "servers": ["agg", "github", "tracker", "chat", "mail"],
      "clientOptions": {
        "plugins": ["aggregate-plugin"]
      }
    }
  ],
  "pricing": {
    "claude-sonnet-4-5": {
      "input": 3,
      "output": 15
    }
  }
}
