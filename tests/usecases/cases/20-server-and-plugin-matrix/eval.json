{
  "name": "server-and-plugin-matrix",
  "datasets": ["./dataset.json"],
  "servers": {
    "github": "{{server github}}",
    "tracker": "{{server tracker}}",
    "chat": "{{server chat}}",
    "mail": "{{server mail}}",
    "docs": "{{server docs}}",
    "wiki": "{{server wiki}}"
  },
  "client": "usecase/client/model",
  "model": "claude-sonnet-4-5",
  "clientOptions": {
    "policy": [
      {
        "when": {
          "plugin": "docs-plugin"
        },
        "steps": [
          {
            "skill": "docs-search"
          },
          {
            "call": {
              "nameIncludes": "search"
            },
            "args": {
              "query": "checkout outage"
            },
            "all": true
          }
        ]
      },
      {
        "steps": [
          {
            "call": {
              "nameIncludes": "search"
            },
            "args": {
              "query": "checkout outage"
            },
            "all": true
          },
          {
            "call": {
              "name": "read_document"
            },
            "args": {
              "id": "inc-482"
            }
          }
        ]
      }
    ]
  },
  "metrics": [
    "passed",
    "tool_count",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "judge_pass"
  ],
  "variants": [
    {
      "name": "four-servers",
      "servers": ["github", "tracker", "chat", "mail"]
    },
    {
      "name": "docs-wiki",
      "servers": ["docs", "wiki"]
    },
    {
      "name": "docs-four-servers",
      "servers": ["docs", "github", "tracker", "chat", "mail"]
    },
    {
      "name": "docs-wiki-plugin",
      "servers": ["docs", "wiki"],
      "clientOptions": {
        "plugins": ["docs-plugin"]
      }
    },
    {
      "name": "docs-four-servers-plugin",
      "servers": ["docs", "github", "tracker", "chat", "mail"],
      "clientOptions": {
        "plugins": ["docs-plugin"]
      }
    }
  ],
  "pricing": {
    "claude-sonnet-4-5": {
      "input": 3,
      "output": 15
    }
  }
}
