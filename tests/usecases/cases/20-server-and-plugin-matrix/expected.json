{
  "title": "One dataset across five server and plugin configurations in one run",
  "exitCode": 1,
  "checks": [
    {
      "path": "variants.length",
      "equals": 5
    },
    {
      "path": "variantDeltas.length",
      "equals": 4
    },
    {
      "path": "variants[name=four-servers].metrics.judge_pass_rate",
      "equals": 0
    },
    {
      "path": "variants[name=docs-wiki].metrics.judge_pass_rate",
      "equals": 1
    },
    {
      "path": "variants[name=docs-four-servers].metrics.judge_pass_rate",
      "equals": 1
    },
    {
      "path": "variants[name=docs-wiki-plugin].metrics.judge_pass_rate",
      "equals": 0.5
    },
    {
      "path": "variants[name=docs-four-servers-plugin].metrics.judge_pass_rate",
      "equals": 0
    },
    {
      "path": "variants[name=four-servers].metrics.tool_count_mean",
      "equals": 4
    },
    {
      "path": "variants[name=docs-wiki].metrics.tool_count_mean",
      "equals": 3
    },
    {
      "path": "variants[name=docs-four-servers].metrics.tool_count_mean",
      "equals": 6
    },
    {
      "path": "variants[name=docs-wiki-plugin].metrics.tool_count_mean",
      "equals": 2
    },
    {
      "path": "variants[name=docs-four-servers-plugin].metrics.tool_count_mean",
      "equals": 5
    },
    {
      "path": "variants[name=docs-wiki].metrics.cost_usd_mean",
      "exists": true
    },
    {
      "path": "variants[name=docs-wiki].costSource",
      "equals": "pricing"
    }
  ],
  "ledger": {
    "metrics": ["input_tokens_mean", "output_tokens_mean", "tool_count_mean"],
    "deltas": [
      {
        "key": "metricDeltas.input_tokens_mean",
        "metric": "input_tokens_mean"
      }
    ]
  }
}
