{
  "name": "skill-triggering",
  "datasets": ["./dataset.json"],
  "servers": [],
  "host": {
    "type": "usecase/model",
    "policy": [
      {
        "when": {
          "inputStartsWith": "/run"
        },
        "steps": [
          {
            "skill": "run"
          }
        ]
      },
      {
        "steps": [
          {
            "skill": "run",
            "rate": 0.6
          }
        ]
      }
    ]
  },
  "trials": 10,
  "metrics": ["passed", "tool_count"],
  "arms": [
    {
      "name": "implicit"
    },
    {
      "name": "explicit",
      "inputTemplate": "/run {{input}}"
    }
  ]
}
