+/// Convert a borrowed AXURL value without taking ownership or interpreting it.
+/// AXURL is commonly a CFURL, but some providers return a CFString.
+unsafe fn coerce_url_value(value: CFTypeRef) -> Option<String> {
+    use core_foundation::url::CFURL;
+
+    if value.is_null() {
+        return None;
+    }
+    let type_id = core_foundation::base::CFGetTypeID(value);
+    let url = if type_id == CFURL::type_id() {
+        CFURL::wrap_under_get_rule(value as _)
+            .get_string()
+            .to_string()
+    } else if type_id == CFStr::type_id() {
+        CFStr::wrap_under_get_rule(value as _).to_string()
+    } else {
+        return None;
+    };
+    // Preserve the native text verbatim; only an empty value is unavailable.
+    (!url.trim().is_empty()).then_some(url)
+}
+
+/// Copy a native URL attribute. Missing, empty, and unsupported values are absent.
+/// Unlike `copy_string_attr`, this accepts CFURL as well as CFString.
+///
+/// # Safety
+///
+/// `element` must be a valid, live `AXUIElementRef` for the duration of the call.
+pub unsafe fn copy_url_attr(element: AXUIElementRef, attr_name: &str) -> Option<String> {
+    let attr = CFStr::new(attr_name);
+    let mut value: CFTypeRef = std::ptr::null();
+    let err = AXUIElementCopyAttributeValue(element, attr.as_concrete_TypeRef(), &mut value);
+    if err != kAXErrorSuccess || value.is_null() {
+        return None;
+    }
+    let result = coerce_url_value(value);
+    CFRelease(value);
+    result
+}
