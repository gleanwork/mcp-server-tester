+            }
+            assert!(started);
+            assert_eq!(keys.calls, ["cmd+a", "cmd+v", "settle"]);
+            assert_eq!(board.contents, original);
+        }
+    }
+
+    #[test]
+    fn paste_transaction_refuses_wrong_window_before_keys_and_restores() {
+        let mut board = FakeBoard::original();
+        let original = board.contents.clone();
+        let mut keys = FakeKeys {
+            wrong_target: true,
+            ..Default::default()
+        };
+        let mut started = false;
+        {
+            let mut transaction = Transaction::begin(&mut board).unwrap();
+            transaction.install("temporary").unwrap();
+            assert!(replace_selection(&transaction, &mut keys, &mut started).is_err());
+        }
+        assert!(!started);
+        assert!(keys.calls.is_empty());
+        assert_eq!(board.contents, original);
+    }
+
+    #[test]
+    fn paste_transaction_refuses_keys_after_clipboard_ownership_change() {
+        let mut board = FakeBoard::original();
+        let mut keys = FakeKeys::default();
+        let mut started = false;
+        let mut transaction = Transaction::begin(&mut board).unwrap();
+        transaction.install("temporary").unwrap();
+        transaction.board.generation += 1;
+        assert!(replace_selection(&transaction, &mut keys, &mut started).is_err());
+        assert!(!started);
+        assert!(keys.calls.is_empty());
+        assert!(!transaction.restore());
+    }
+
+    #[test]
+    fn paste_transaction_refuses_install_if_snapshot_ownership_changed() {
+        let mut board = FakeBoard::original();
+        let mut transaction = Transaction::begin(&mut board).unwrap();
+        transaction.board.generation += 1;
+        transaction.board.contents = Contents(vec![]);
+        assert!(transaction.install("temporary").is_err());
+        drop(transaction);
+        assert!(board.contents.0.is_empty());
+    }
+
+    #[test]
+    fn paste_transaction_reports_restore_failure_without_retrying() {
+        let mut board = FakeBoard::original();
+        let mut transaction = Transaction::begin(&mut board).unwrap();
+        transaction.install("temporary").unwrap();
+        transaction.board.fail_write = true;
+        assert!(!transaction.restore());
+        let count = transaction.board.generation;
+        drop(transaction);
+        assert_eq!(board.generation, count);
+    }
+
+    #[test]
+    fn paste_transaction_restores_empty_clipboard() {
+        let mut board = FakeBoard::original();
