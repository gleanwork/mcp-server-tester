+//! One foreground, exact-window, clipboard-preserving paste operation (macOS only).
+//! See docs/paste-text-macos.md for AppKit race and synchronous-call limits.
+use async_trait::async_trait;
+use cua_driver_contract::{PasteEffect, PasteTextInput, PasteTextOutput};
+use cua_driver_core::{
+    protocol::ToolResult,
+    tool::{PasteAdmission, Tool, ToolDef},
+};
+use serde_json::Value;
+use std::{sync::OnceLock, time::Duration};
+
+use super::{
+    paste_transaction::{replace_selection, PasteKeys, Transaction},
+    pasteboard_native::{NativePasteboard, MAX_BACKUP_BYTES},
+};
+
+pub struct PasteTextTool;
+
+fn outcome(started: bool, restored: bool, failed: bool) -> ToolResult {
+    let output = PasteTextOutput {
+        effect: if started {
+            PasteEffect::Unverifiable
+        } else {
+            PasteEffect::Refused
+        },
+        clipboard_restored: restored,
+    };
+    let metadata = serde_json::to_value(output).expect("paste metadata serializes");
+    let mut result = ToolResult::text(metadata.to_string()).with_structured(metadata);
+    if failed {
+        result.is_error = Some(true);
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn paste_text_schema_follows_shared_mcp_conventions() {
+        let contract = cua_driver_contract::tool_contract("paste_text").unwrap();
+        let violations = cua_driver_core::tool_schema::shared_schema_violations(
+            "paste_text",
+            &contract.input_schema,
+        );
+        assert!(violations.is_empty(), "{violations:?}");
+    }
+
+    #[tokio::test]
+    async fn paste_text_direct_invocation_refuses_without_runtime_admission() {
+        let result = PasteTextTool
+            .invoke(serde_json::json!({
+                "pid": 123, "window_id": 456, "text": "must not touch the desktop"
+            }))
+            .await;
+        assert_eq!(result.is_error, Some(true));
+        assert_eq!(
+            result.structured_content.unwrap(),
+            serde_json::json!({
+                "effect": "refused", "clipboard_restored": true
+            })
+        );
+    }
+
+    #[test]
+    fn paste_text_outcomes_are_only_effect_and_restore_metadata() {
+        for started in [false, true] {
+            for restored in [false, true] {
+                let result = outcome(started, restored, true);
+                let metadata = result.structured_content.unwrap();
+                assert_eq!(metadata.as_object().unwrap().len(), 2);
+                assert_eq!(metadata["clipboard_restored"], restored);
+                assert_eq!(
+                    metadata["effect"],
+                    if started { "unverifiable" } else { "refused" }
+                );
+                assert_eq!(result.is_error, Some(true));
+            }
+        }
+    }
+}
+
+struct NativeKeys {
+    pid: i32,
+    window_id: u32,
+}
+impl PasteKeys for NativeKeys {
+    fn verify(&self) -> Result<(), ()> {
+        if !matches!(
+            crate::windows::resolve_window_owner(self.pid, self.window_id),
+            crate::windows::WindowOwner::SamePid
+        ) || crate::input::skylight::front_process_matches(self.pid, self.window_id)
+            != Some(true)
+            || crate::ax::bindings::focused_window_id_of_pid(self.pid) != Some(self.window_id)
+        {
+            return Err(());
+        }
+        Ok(())
+    }
+    fn select_all(&mut self) -> Result<(), ()> {
+        crate::input::keyboard::press_key_global("a", &["cmd"]).map_err(|_| ())?;
+        std::thread::sleep(Duration::from_millis(50));
+        Ok(())
+    }
+    fn paste(&mut self) -> Result<(), ()> {
+        crate::input::keyboard::press_key_global("v", &["cmd"]).map_err(|_| ())
+    }
+    fn settle(&mut self) {
+        // AppKit has no reliable paste-consumed acknowledgement. This is a bounded
+        // settle, not proof of application delivery; effect remains unverifiable.
+        std::thread::sleep(Duration::from_millis(500));
+    }
+}
+
+#[async_trait]
+impl Tool for PasteTextTool {
+    fn def(&self) -> &ToolDef {
+        static DEF: OnceLock<ToolDef> = OnceLock::new();
+        DEF.get_or_init(|| {
+            ToolDef::from_contract(
+                &cua_driver_contract::tool_contract("paste_text").expect("paste contract"),
+            )
+        })
+    }
+
+    async fn invoke(&self, _args: Value) -> ToolResult {
+        // Direct invocation cannot prove desktop/recording admission. Only the
+        // authorized registry path can supply the opaque worker guard below.
+        outcome(false, true, true)
+    }
+
+    async fn invoke_with_paste_admission(
+        &self,
+        mut args: Value,
+        admission: PasteAdmission,
+    ) -> ToolResult {
+        cua_driver_core::tool_args::sanitize_reserved_args(&mut args);
+        // Do not surface serde errors: a malformed request could embed text in them.
+        let Ok(input) = serde_json::from_value::<PasteTextInput>(args) else {
+            return outcome(false, true, true);
+        };
+        if input.pid <= 0 || input.window_id == 0 || input.text.len() > MAX_BACKUP_BYTES {
+            return outcome(false, true, true);
+        }
+        let lease = super::acquire_background_mutation(input.pid).await;
+        let prior_front = crate::apps::frontmost_pid();
+        crate::focus_guard::with_focus_suppressed(
+            Some(input.pid),
+            prior_front,
+            "paste_text",
+            || async move {
+                tokio::task::spawn_blocking(move || {
+                    // Keep ownership in the worker if the requesting future is canceled.
+                    let _admission = admission;
+                    let _lease = lease;
+                    let Ok(_clipboard_lock) = super::clipboard::CLIPBOARD_ACCESS.try_lock() else {
+                        return outcome(false, true, true);
+                    };
+                    objc2::rc::autoreleasepool(|_| {
+                        if !matches!(
+                            crate::windows::resolve_window_owner(input.pid, input.window_id),
+                            crate::windows::WindowOwner::SamePid
+                        ) {
+                            return outcome(false, true, true);
+                        }
+                        let mut board = NativePasteboard::general();
+                        let Ok(mut transaction) = Transaction::begin(&mut board) else {
+                            return outcome(false, true, true);
+                        };
+                        let mut started = false;
+                        let result = transaction.install(&input.text).and_then(|()| {
+                            crate::input::skylight::with_foreground_hid_activation(
+                                input.pid,
+                                input.window_id,
+                                || {
+                                    let mut keys = NativeKeys {
+                                        pid: input.pid,
+                                        window_id: input.window_id,
+                                    };
+                                    replace_selection(&transaction, &mut keys, &mut started)
+                                        .map_err(|()| anyhow::anyhow!("paste refused"))
+                                },
+                            )
+                            .map_err(|_| ())
+                        });
+                        let restored = transaction.restore();
+                        outcome(started, restored, result.is_err() || !restored)
+                    })
+                })
+                .await
+                .unwrap_or_else(|_| outcome(true, false, true))
+            },
+        )
+        .await
+    }
+}
