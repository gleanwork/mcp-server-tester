+/// Blocks recording start while an admitted paste can expose temporary text.
+/// Owned by the paste worker, not the cancelable registry invocation.
+pub(crate) struct PasteRecordingExclusion {
+    recording: Arc<RecordingSession>,
+}
+
+impl Drop for PasteRecordingExclusion {
+    fn drop(&mut self) {
+        let mut inner = self
+            .recording
+            .inner
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        inner.active_pastes -= 1;
+    }
+}
+
