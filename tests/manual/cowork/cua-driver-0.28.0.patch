+        let recording = Arc::new(RecordingSession::new());
+        let mut inner = recording.inner.lock().unwrap();
+        let (attempting_tx, attempting) = std::sync::mpsc::channel();
+        let worker_recording = recording.clone();
+        let worker = std::thread::spawn(move || {
+            attempting_tx.send(()).unwrap();
+            worker_recording.try_exclude_paste().is_none()
+        });
+        attempting
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .unwrap();
+        // Simulate start's enabled write while holding its actual mutex. No
+        // video, cursor sampler, or filesystem operation runs in this test.
+        inner.enabled = true;
+        drop(inner);
+        assert!(worker.join().unwrap());
+        assert_eq!(recording.inner.lock().unwrap().active_pastes, 0);
+        recording.inner.lock().unwrap().enabled = false;
+        assert!(recording.try_exclude_paste().is_some());
+    }
