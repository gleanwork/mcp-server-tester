+    /// Test and reserve under the same mutex as `start()`. The owned guard can
+    /// cross spawn_blocking and outlive a canceled caller. Poison refuses paste.
+    pub(crate) fn try_exclude_paste(self: &Arc<Self>) -> Option<PasteRecordingExclusion> {
+        let mut inner = self.inner.lock().ok()?;
+        if inner.enabled {
+            return None;
+        }
+        inner.active_pastes += 1;
+        Some(PasteRecordingExclusion {
+            recording: self.clone(),
+        })
+    }
+
