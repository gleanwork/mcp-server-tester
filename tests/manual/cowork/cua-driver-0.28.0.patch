+//! In-memory clipboard transaction seam. Tests use fake storage, never AppKit.
+
+pub(super) trait Pasteboard {
+    type Contents;
+    fn snapshot(&mut self) -> Result<(isize, Self::Contents), ()>;
+    fn text(&self, text: &str) -> Result<Self::Contents, ()>;
+    fn change_count(&self) -> isize;
+    fn clear(&mut self) -> isize;
+    /// Must refuse if `generation` is no longer current; must not adopt a newer generation.
+    fn write(&mut self, contents: &Self::Contents, generation: isize) -> Result<(), ()>;
+}
+
+pub(super) struct Transaction<'a, B: Pasteboard> {
+    board: &'a mut B,
+    backup: Option<B::Contents>,
+    generation: isize,
+    modified: bool,
+}
+
+impl<'a, B: Pasteboard> Transaction<'a, B> {
+    pub(super) fn begin(board: &'a mut B) -> Result<Self, ()> {
+        let (generation, backup) = board.snapshot()?;
+        Ok(Self {
+            board,
+            backup: Some(backup),
+            generation,
+            modified: false,
+        })
+    }
+
+    pub(super) fn is_current(&self) -> bool {
+        self.board.change_count() == self.generation
+    }
+
+    pub(super) fn install(&mut self, text: &str) -> Result<(), ()> {
+        let contents = self.board.text(text)?;
+        if !self.is_current() {
+            return Err(());
+        }
+        self.generation = self.board.clear();
+        self.modified = true;
+        self.board.write(&contents, self.generation)
+    }
+
+    pub(super) fn restore(&mut self) -> bool {
+        let Some(backup) = self.backup.take() else {
+            return !self.modified;
+        };
+        if !self.modified {
+            return true;
+        }
+        if !self.is_current() {
+            return false;
+        }
+        self.generation = self.board.clear();
+        let restored = self.board.write(&backup, self.generation).is_ok();
+        self.modified = !restored;
+        restored
+    }
+}
+
+impl<B: Pasteboard> Drop for Transaction<'_, B> {
+    fn drop(&mut self) {
+        self.restore();
+    }
+}
+
+pub(super) trait PasteKeys {
+    fn verify(&self) -> Result<(), ()>;
+    fn select_all(&mut self) -> Result<(), ()>;
+    fn paste(&mut self) -> Result<(), ()>;
+    fn settle(&mut self);
+}
+
+/// Only two chords exist at this seam. No free-form key or submit parameter.
+pub(super) fn replace_selection<B: Pasteboard, K: PasteKeys>(
+    transaction: &Transaction<'_, B>,
+    keys: &mut K,
+    started: &mut bool,
+) -> Result<(), ()> {
+    keys.verify()?;
+    if !transaction.is_current() {
+        return Err(());
+    }
+    *started = true;
+    keys.select_all()?;
+    keys.verify()?;
+    if !transaction.is_current() {
+        return Err(());
+    }
+    let result = keys.paste();
+    // Even a failed actuator may have queued a key-down; do not restore early.
+    keys.settle();
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[derive(Clone, PartialEq, Eq, Debug)]
+    struct Contents(Vec<Vec<(String, Vec<u8>)>>);
+
+    struct FakeBoard {
+        contents: Contents,
+        generation: isize,
+        fail_write: bool,
+        fail_snapshot: bool,
+    }
+
+    impl FakeBoard {
+        fn original() -> Self {
+            Self {
+                contents: Contents(vec![
+                    vec![
+                        ("public.rtf".into(), b"{\\rtf1 original}".to_vec()),
+                        ("vendor.custom".into(), vec![0, 255, 7]),
+                    ],
+                    vec![("public.file-url".into(), b"file:///example".to_vec())],
+                ]),
+                generation: 4,
+                fail_write: false,
+                fail_snapshot: false,
+            }
+        }
+    }
+
+    impl Pasteboard for FakeBoard {
+        type Contents = Contents;
+        fn snapshot(&mut self) -> Result<(isize, Contents), ()> {
+            if self.fail_snapshot {
+                return Err(());
+            }
+            Ok((self.generation, self.contents.clone()))
+        }
+        fn text(&self, text: &str) -> Result<Contents, ()> {
+            Ok(Contents(vec![vec![(
+                "public.utf8-plain-text".into(),
+                text.as_bytes().to_vec(),
+            )]]))
+        }
+        fn change_count(&self) -> isize {
+            self.generation
+        }
+        fn clear(&mut self) -> isize {
+            self.generation += 1;
+            self.contents.0.clear();
+            self.generation
+        }
+        fn write(&mut self, contents: &Contents, generation: isize) -> Result<(), ()> {
+            if self.fail_write {
+                self.fail_write = false;
+                return Err(());
+            }
+            if generation != self.generation {
+                return Err(());
+            }
+            self.contents = contents.clone();
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn paste_transaction_unreadable_backup_refuses_before_modification() {
+        let mut board = FakeBoard::original();
+        let original = board.contents.clone();
+        board.fail_snapshot = true;
+        assert!(Transaction::begin(&mut board).is_err());
+        assert_eq!(board.contents, original);
+        assert_eq!(board.generation, 4);
+    }
+
+    #[derive(Default)]
+    struct FakeKeys {
+        calls: Vec<&'static str>,
+        fail_paste: bool,
+        wrong_target: bool,
+    }
+    impl PasteKeys for FakeKeys {
+        fn verify(&self) -> Result<(), ()> {
+            if self.wrong_target {
+                Err(())
+            } else {
+                Ok(())
+            }
+        }
+        fn select_all(&mut self) -> Result<(), ()> {
+            self.calls.push("cmd+a");
+            Ok(())
+        }
+        fn paste(&mut self) -> Result<(), ()> {
+            self.calls.push("cmd+v");
+            if self.fail_paste {
+                Err(())
+            } else {
+                Ok(())
+            }
+        }
+        fn settle(&mut self) {
+            self.calls.push("settle");
+        }
+    }
+
+    #[test]
+    fn paste_transaction_only_selects_pastes_and_settles_on_success_or_key_failure() {
+        for fail_paste in [false, true] {
+            let mut board = FakeBoard::original();
+            let original = board.contents.clone();
+            let mut keys = FakeKeys {
+                fail_paste,
+                ..Default::default()
+            };
+            let mut started = false;
+            {
+                let mut transaction = Transaction::begin(&mut board).unwrap();
+                transaction.install("temporary").unwrap();
