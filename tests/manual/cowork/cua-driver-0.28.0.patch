+    }
+
+    #[test]
+    fn paste_transaction_restores_all_items_formats_and_bytes_after_success() {
+        let mut board = FakeBoard::original();
+        let original = board.contents.clone();
+        let mut transaction = Transaction::begin(&mut board).unwrap();
+        transaction.install("exact\ntext").unwrap();
+        assert!(transaction.restore());
+        drop(transaction);
+        assert_eq!(board.contents, original);
+    }
+}
