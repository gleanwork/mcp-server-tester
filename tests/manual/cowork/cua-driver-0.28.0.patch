@@ -0,0 +1,101 @@
+//! macOS-only transactional text paste. No clipboard contents in the output.
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+
+use crate::{Platform, SchemaMode, ToolAnnotations, ToolContract, ToolInput, ToolOutput};
+
+// Intentionally no Debug implementation: text must not enter diagnostics.
+#[derive(Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct PasteTextInput {
+    pub pid: i32,
+    pub window_id: u32,
+    /// Exact text; no sanitization or Return keystroke is applied.
+    pub text: String,
+    /// For multi-call work, prefer a short public session label and repeat it on every call that accepts it.
+    /// Omit it to use the authenticated transport's implicit lifecycle session.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[schemars(with = "String")]
+    pub session: Option<String>,
+}
+
+impl ToolInput for PasteTextInput {
+    const TOOL_NAME: &'static str = "paste_text";
+}
+
+#[derive(Clone, Copy, Serialize, Deserialize, JsonSchema, PartialEq, Eq, Debug)]
+#[serde(rename_all = "snake_case")]
+pub enum PasteEffect {
+    Refused,
+    Unverifiable,
+}
+
+#[derive(Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct PasteTextOutput {
+    pub effect: PasteEffect,
+    /// False if another clipboard owner intervened or restoration failed.
+    pub clipboard_restored: bool,
+}
+
+impl ToolOutput for PasteTextOutput {}
+
+pub(crate) fn contract() -> ToolContract {
+    ToolContract {
+        name: "paste_text".into(),
+        description: "macOS only: replace the focused field in exact pid/window_id with text using foreground Cmd+A then Cmd+V, never Return. Uses the window's existing focused field; element targeting fields are not accepted. Backs up every readable pasteboard item/type/data in native memory (16 MiB total); unreadable and promised formats refuse before mutation. Waits 500 ms for paste settle, then restores if the clipboard generation is still owned. AppKit has no atomic ownership compare-and-swap or cancellable provider reads. Returns only effect and clipboard_restored; unverifiable requires independent UI confirmation. Active Cua recording refuses; recording start is excluded until the paste worker exits, including restoration after caller cancellation. This tool never records text or clipboard backup.".into(),
+        platforms: vec![Platform::Macos],
+        aliases: vec![],
+        capabilities: vec!["input.text.paste_transaction".into(), "clipboard.transaction".into()],
+        annotations: ToolAnnotations { read_only: false, destructive: true, idempotent: false, open_world: true },
+        schema_mode: SchemaMode::CanonicalRuntime,
+        cursor_semantics: None,
+        input_schema: PasteTextInput::input_schema(),
+        success_output_schema: Some(PasteTextOutput::output_schema()),
+        output_validator: crate::validate_typed_output::<PasteTextOutput>,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn paste_text_rejects_removed_targeting_fields() {
+        for field in ["element_index", "element_token", "snapshot_id"] {
+            for value in [
+                serde_json::json!(0),
+                serde_json::json!("target"),
+                serde_json::Value::Null,
+            ] {
+                let mut args = serde_json::json!({"pid": 123, "window_id": 456, "text": "exact"});
+                args[field] = value;
+                assert!(
+                    serde_json::from_value::<PasteTextInput>(args).is_err(),
+                    "accepted {field}"
+                );
+            }
+            assert!(contract().input_schema["properties"].get(field).is_none());
+        }
+        assert_eq!(contract().input_schema["additionalProperties"], false);
+    }
+
+    #[test]
+    fn paste_text_contract_is_mac_only_and_exact_targeted() {
+        let tool = contract();
+        assert_eq!(tool.platforms, vec![Platform::Macos]);
+        assert!(tool.annotations.destructive && !tool.annotations.read_only);
+        let required = tool.input_schema["required"].as_array().unwrap();
+        for key in ["pid", "window_id", "text"] {
+            assert!(required.contains(&key.into()));
+        }
+        let output = serde_json::to_value(PasteTextOutput {
+            effect: PasteEffect::Unverifiable,
+            clipboard_restored: true,
+        })
+        .unwrap();
+        assert_eq!(
+            output,
+            serde_json::json!({"effect":"unverifiable", "clipboard_restored":true})
+        );
+    }
+}
