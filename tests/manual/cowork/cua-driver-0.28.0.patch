+        let second = recording.try_exclude_paste().unwrap();
+        let file = tempfile::NamedTempFile::new().unwrap();
+        let invalid_output = file.path().join("recording");
+        let path = invalid_output.to_str().unwrap();
+        for guard in [first, second] {
+            assert!(recording
+                .start(path, false, None)
+                .unwrap_err()
+                .to_string()
+                .contains("paste"));
+            assert!(recording
+                .configure(true, Some(path))
+                .unwrap_err()
+                .to_string()
+                .contains("paste"));
+            recording.stop_owner(None).unwrap();
+            drop(guard);
+        }
+        assert_eq!(recording.inner.lock().unwrap().active_pastes, 0);
+        // Without exclusion start reaches filesystem validation, which fails
+        // before any recorder/cursor capture can start.
+        assert!(!recording
+            .start(path, false, None)
+            .unwrap_err()
+            .to_string()
+            .contains("paste"));
+    }
+
