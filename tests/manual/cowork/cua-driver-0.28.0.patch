+    }
+
+    #[test]
+    fn paste_transaction_does_not_overwrite_newer_user_clipboard() {
+        let mut board = FakeBoard::original();
+        let mut transaction = Transaction::begin(&mut board).unwrap();
+        transaction.install("temporary").unwrap();
+        transaction.board.clear();
