@@ -0,0 +1,257 @@
+//! Lossless eager AppKit backup; clipboard-rs's public API flattens item boundaries.
+//! Contents never implement Debug/Serialize and never leave this worker's memory.
+use std::time::{Duration, Instant};
+
+use objc2::{rc::Retained, runtime::ProtocolObject};
+use objc2_app_kit::{NSPasteboard, NSPasteboardItem, NSPasteboardWriting};
+use objc2_foundation::{NSArray, NSData, NSString};
+
+use super::paste_transaction::Pasteboard;
+
+pub(super) const MAX_BACKUP_BYTES: usize = 16 * 1024 * 1024;
+const MAX_ITEMS: usize = 128;
+const MAX_TYPES: usize = 1024;
+const SNAPSHOT_BUDGET: Duration = Duration::from_secs(2);
+
+pub(super) struct NativePasteboard(Retained<NSPasteboard>);
+pub(super) struct Contents(Vec<Retained<NSPasteboardItem>>);
+
+impl NativePasteboard {
+    // Created only inside the blocking operation, never by tests or tool discovery.
+    pub(super) fn general() -> Self {
+        Self(unsafe { NSPasteboard::generalPasteboard() })
+    }
+}
+
+fn account_bytes(total: usize, added: usize) -> Result<usize, ()> {
+    total
+        .checked_add(added)
+        .filter(|n| *n <= MAX_BACKUP_BYTES)
+        .ok_or(())
+}
+
+fn canonical_legacy_type(kind: &str) -> &str {
+    // AppKit exposes these legacy aliases on NSPasteboard.types even when
+    // NSPasteboardItem.types contains only the canonical UTI. Restoring the
+    // canonical item regenerates the aliases; they are not extra provider data.
+    match kind {
+        "NSStringPboardType" => "public.utf8-plain-text",
+        "Apple HTML pasteboard type" => "public.html",
+        "NeXT Rich Text Format v1.0 pasteboard type" => "public.rtf",
+        _ => kind,
+    }
+}
+
+fn supported_type(kind: &str) -> bool {
+    // File promises require the original provider's code, not just serialized data.
+    // Never invoke a file-promise receiver or materialize files during a backup.
+    !kind.to_ascii_lowercase().contains("promise")
+}
+
+impl Pasteboard for NativePasteboard {
+    type Contents = Contents;
+
+    fn snapshot(&mut self) -> Result<(isize, Contents), ()> {
+        let deadline = Instant::now() + SNAPSHOT_BUDGET;
+        let generation = self.change_count();
+        let mut backup = Vec::new();
+        let mut bytes = 0usize;
+        let mut type_count = 0usize;
+        let mut copied_types = std::collections::BTreeSet::new();
+        unsafe {
+            // nil can signal a read error. Only a successfully read empty array
+            // is an empty board; never clear an unreadable/provider-only board.
+            let items = self.0.pasteboardItems().ok_or(())?;
+            let declared = self.0.types();
+            if (items.is_empty() && declared.as_ref().is_some_and(|types| !types.is_empty()))
+                || (!items.is_empty() && declared.is_none())
+            {
+                return Err(());
+            }
+            {
+                if items.len() > MAX_ITEMS {
+                    return Err(());
+                }
+                for item in items.iter() {
+                    let copy = NSPasteboardItem::new();
+                    let types = item.types();
+                    if types.is_empty() {
+                        return Err(());
+                    }
+                    for kind in types.iter() {
+                        type_count += 1;
+                        bytes = account_bytes(bytes, kind.len())?;
+                        if type_count > MAX_TYPES
+                            || Instant::now() >= deadline
+                            || !supported_type(&kind.to_string())
+                        {
+                            return Err(());
+                        }
+                        let data = item.dataForType(&kind).ok_or(())?;
+                        bytes = account_bytes(bytes, data.len())?;
+                        if Instant::now() >= deadline {
+                            return Err(());
+                        }
+                        // Make an independent byte copy before relinquishing the original owner.
+                        if !copy.setData_forType(&NSData::with_bytes(data.bytes()), &kind) {
+                            return Err(());
+                        }
+                        copied_types.insert(kind.to_string());
+                    }
+                    backup.push(copy);
+                }
+            }
+            if let Some(declared) = declared {
+                if declared.len() > MAX_TYPES {
+                    return Err(());
+                }
+                for kind in declared.iter() {
+                    if kind.len() > MAX_BACKUP_BYTES
+                        || !copied_types.contains(canonical_legacy_type(&kind.to_string()))
+                    {
+                        return Err(());
+                    }
+                }
+            }
+        }
+        if self.change_count() != generation || Instant::now() >= deadline {
+            return Err(());
+        }
+        Ok((generation, Contents(backup)))
+    }
+
+    fn text(&self, text: &str) -> Result<Contents, ()> {
+        if text.len() > MAX_BACKUP_BYTES {
+            return Err(());
+        }
+        unsafe {
+            let item = NSPasteboardItem::new();
+            if !item.setString_forType(
+                &NSString::from_str(text),
+                &NSString::from_str("public.utf8-plain-text"),
+            ) {
+                return Err(());
+            }
+            Ok(Contents(vec![item]))
+        }
+    }
+
+    fn change_count(&self) -> isize {
+        unsafe { self.0.changeCount() }
+    }
+    fn clear(&mut self) -> isize {
+        unsafe { self.0.clearContents() }
+    }
+
+    fn write(&mut self, contents: &Contents, generation: isize) -> Result<(), ()> {
+        if self.change_count() != generation {
+            return Err(());
+        }
+        if !contents.0.is_empty() {
+            let objects: Vec<Retained<ProtocolObject<dyn NSPasteboardWriting>>> = contents
+                .0
+                .iter()
+                .map(|item| ProtocolObject::from_retained(item.clone()))
+                .collect();
+            let objects = NSArray::from_vec(objects);
+            if !unsafe { self.0.writeObjects(&objects) } {
+                return Err(());
+            }
+        }
+        // Never adopt a generation read after write: it could belong to a user copy.
+        if self.change_count() != generation {
+            return Err(());
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn paste_transaction_named_pasteboard_preserves_html_and_custom_data() {
+        // A newly allocated NAMED pasteboard, never the user's general clipboard.
+        objc2::rc::autoreleasepool(|_| unsafe {
+            let board = NSPasteboard::pasteboardWithUniqueName();
+            board.clearContents();
+            let item = NSPasteboardItem::new();
+            for (kind, bytes) in [
+                ("public.utf8-plain-text", b"original text".as_slice()),
+                ("public.html", b"<b>original text</b>".as_slice()),
+                ("org.example.opaque", [0u8, 255, 9].as_slice()),
+            ] {
+                assert!(item.setData_forType(&NSData::with_bytes(bytes), &NSString::from_str(kind)));
+            }
+            let objects = NSArray::from_vec(vec![
+                ProtocolObject::<dyn NSPasteboardWriting>::from_retained(item),
+            ]);
+            assert!(board.writeObjects(&objects));
+            let original_generation = board.changeCount();
+            let mut original_types: Vec<_> = board
+                .types()
+                .unwrap()
+                .iter()
+                .map(|kind| kind.to_string())
+                .collect();
+            original_types.sort();
+            let mut native = NativePasteboard(board.clone());
+            let mut transaction = super::super::paste_transaction::Transaction::begin(&mut native)
+                .expect("all declared formats must be backed up");
+            transaction
+                .install("temporary text")
+                .expect("own write must retain ownership");
+            assert!(
+                transaction.restore(),
+                "all original formats must be restored"
+            );
+            drop(transaction);
+            assert!(board.changeCount() > original_generation);
+            let mut restored_types: Vec<_> = board
+                .types()
+                .unwrap()
+                .iter()
+                .map(|kind| kind.to_string())
+                .collect();
+            restored_types.sort();
+            assert_eq!(restored_types, original_types);
+            assert_eq!(
+                board
+                    .stringForType(&NSString::from_str("public.utf8-plain-text"))
+                    .unwrap()
+                    .to_string(),
+                "original text"
+            );
+            assert_eq!(
+                board
+                    .dataForType(&NSString::from_str("public.html"))
+                    .unwrap()
+                    .bytes(),
+                b"<b>original text</b>"
+            );
+            assert_eq!(
+                board
+                    .dataForType(&NSString::from_str("org.example.opaque"))
+                    .unwrap()
+                    .bytes(),
+                &[0, 255, 9]
+            );
+            board.clearContents();
+        });
+    }
+
+    #[test]
+    fn paste_transaction_backup_budget_rejects_oversize_and_overflow_without_allocating() {
+        assert_eq!(account_bytes(0, MAX_BACKUP_BYTES), Ok(MAX_BACKUP_BYTES));
+        assert!(account_bytes(MAX_BACKUP_BYTES, 1).is_err());
+        assert!(account_bytes(1, usize::MAX).is_err());
+    }
+
+    #[test]
+    fn paste_transaction_rejects_provider_promises_but_supports_opaque_formats() {
+        assert!(!supported_type("com.apple.pasteboard.promised-file-url"));
+        assert!(!supported_type("NSFilesPromisePboardType"));
+        assert!(supported_type("com.vendor.arbitrary-binary"));
+        assert!(supported_type("public.rtf"));
+    }
+}
