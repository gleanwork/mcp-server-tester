#!/bin/bash
# The container's main process. As root, it opens the VM devices to the
# desktop user and writes Claude Desktop's base settings; as that user, it
# starts the X server, the session bus, AT-SPI and Claude Desktop, then waits.
#
# Base settings come from the environment (`mst run --env docker` sets them):
#   MST_INFERENCE_GATEWAY_URL   an LLM gateway's Anthropic-compatible base URL
#   MST_INFERENCE_AUTH_SCHEME   how the token is sent (default: bearer)
#   MST_INFERENCE_MODELS        comma-separated models Claude Desktop offers
# The token itself is read from /run/mst/inference-token when Claude asks.
set -euo pipefail

if [[ "$(id -u)" == 0 ]]; then
  # The devices are this container's own nodes: opening them here changes
  # nothing on the host.
  for device in /dev/kvm /dev/vhost-net /dev/vhost-vsock /dev/net/tun; do
    [[ -e "${device}" ]] && chmod 0666 "${device}"
  done
  install -d -o mst -g mst -m 0700 /run/mst /run/mst/session /run/mst/tokens \
    /run/mst/settings
  # The staged settings MST writes over (MST_COWORK_SETTINGS_FILE);
  # restart-desktop installs a root-owned copy for Claude Desktop.
  staging=/run/mst/settings/managed-settings.json
  if [[ -n "${MST_INFERENCE_GATEWAY_URL:-}" ]]; then
    node /opt/mst/bin/base-settings.mjs > "${staging}"
  else
    echo '{}' > "${staging}"
  fi
  chown mst:mst "${staging}"
  chmod 0600 "${staging}"
  exec setpriv --reuid=mst --regid=mst --init-groups --reset-env \
    env PATH="${PATH}" HOME=/home/mst USER=mst LANG="${LANG}" \
    DISPLAY="${DISPLAY}" DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" "$0"
fi

log=/run/mst/session
Xvfb "${DISPLAY}" -screen 0 1440x900x24 -nolisten tcp > "${log}/xvfb.log" 2>&1 &
xvfb=$!
for _ in $(seq 50); do
  [[ -S "/tmp/.X11-unix/X${DISPLAY#:}" ]] && break
  sleep 0.1
done

dbus-daemon --session --address="${DBUS_SESSION_BUS_ADDRESS}" --nofork \
  > "${log}/dbus.log" 2>&1 &
for _ in $(seq 50); do
  [[ -S "${DBUS_SESSION_BUS_ADDRESS#unix:path=}" ]] && break
  sleep 0.1
done
# Accessibility on, so Chromium exposes its tree to AT-SPI.
/usr/libexec/at-spi-bus-launcher --launch-immediately > "${log}/at-spi.log" 2>&1 &
gdbus call --session --dest org.a11y.Bus --object-path /org/a11y/bus \
  --method org.freedesktop.DBus.Properties.Set org.a11y.Status IsEnabled '<true>' \
  > /dev/null 2>&1 || true

# A desktop that doesn't come up stays running, so its logs can be read.
# The first launch also downloads Cowork's VM, so it gets longer.
if MST_COWORK_WARM_VM_TIMEOUT_S=900 /opt/mst/bin/restart-desktop \
  2> "${log}/restart.log"; then
  touch "${log}/ready"
else
  touch "${log}/failed"
fi
wait "${xvfb}"
