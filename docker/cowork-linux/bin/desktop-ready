#!/bin/sh
# Waits until Claude Desktop shows Cowork's prompt, with Cowork's VM running.
# The check is MST's own code (src/evals/cowork/desktopReady.ts), run on the
# image's Node from the MST package the image installed (`mst` is its
# dist/cli/index.js).
mst="$(command -v mst)" || { echo "desktop-ready: mst isn't on PATH" >&2; exit 1; }
exec node "$(dirname "$(readlink -f "${mst}")")/../cowork/desktopReady.js"
