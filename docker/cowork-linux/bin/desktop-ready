#!/usr/bin/python3
"""Waits until Claude Desktop shows Cowork's prompt, over AT-SPI, with
Cowork's VM running.

On a profile's first launch in gateway mode, Claude shows one screen,
"Your organization has set up Claude to run through a custom inference
gateway", with a Continue button. This is the image's own first-run step,
not part of a case: MST's driver never clicks through onboarding.

Cowork starts its VM for the first task after a launch, and gives the guest
60 s to connect. Under nested virtualization (a Mac's Docker VM) the guest
takes longer, so that task fails. After a profile's first failure Claude
stops the VM and reinstalls it, unless the profile is marked as having
reinstalled already (desktop-session marks it when the image seeded the
bundle); after a later one it lets the VM finish booting. Unless
MST_COWORK_WARM_VM=0, this starts one-line warm-up tasks
until a VM startup completes, then goes back to a new task, so a case's task
finds the VM running.

The guest connecting ("guest ready") isn't enough: Cowork then installs its
SDK in the guest, with 30 s to do it, and under nested virtualization that
can take longer. The startup then fails ("installSdk timed out") with the VM
still connected, and a task started then has no shell. So a startup counts
only once it completes (Cowork starts its keepalive), after the last
failure; another warm-up task retries the install on the connected VM. A
task that finds the VM connected installs the SDK too, and its failure
("Post-connect setup failed") is retried the same way.

A startup logs every few seconds while it boots. One that stops logging
without a failure has stalled: after STALL_S of silence, another warm-up
task starts it again rather than waiting out the deadline. If no startup
completes, the error names the VM log's last line, where it stopped.
"""
import os
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import quote

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi  # noqa: E402

DEADLINE_S = 120
# Inside MST's limit for the restart command (MST_DESKTOP_RESTART_TIMEOUT_S,
# 900 s in this image): a nested guest can take minutes to boot.
WARM_DEADLINE_S = int(os.environ.get("MST_COWORK_WARM_VM_TIMEOUT_S", "840"))
GATEWAY_NOTICE = "custom inference gateway"
PROMPT = "write your prompt"
VM_LOG = Path.home() / ".config/Claude-3p/logs/cowork_vm_node.log"
OPEN_URL = "/opt/mst/bin/open-url"
# Silence in the VM log, during a warm-up task, that counts as a stall.
STALL_S = int(os.environ.get("MST_COWORK_WARM_VM_STALL_S", "120"))


def claude():
    try:
        desktop = Atspi.get_desktop(0)
        for index in range(desktop.get_child_count()):
            app = desktop.get_child_at_index(index)
            if app is not None and "claude" in (app.get_name() or "").lower():
                return app
    except Exception:
        pass
    return None


def nodes(node, limit=5000):
    stack, seen = [node], 0
    while stack and seen < limit:
        current = stack.pop()
        if current is None:
            continue
        seen += 1
        yield current
        # The tree changes under us while Claude loads: a node can vanish.
        try:
            count = current.get_child_count()
            stack.extend(current.get_child_at_index(i) for i in range(count))
        except Exception:
            continue


def text(node):
    try:
        return (node.get_name() or "").strip()
    except Exception:
        return ""


def role(node):
    try:
        return node.get_role_name()
    except Exception:
        return ""


def button(everything, name):
    return next(
        (n for n in everything if role(n) in ("button", "push button") and text(n) == name),
        None,
    )


def press(node):
    action = node.get_action_iface() if node is not None else None
    return bool(action is not None and action.do_action(0))


def wait_for_prompt(deadline_s):
    """Cowork's prompt is showing, after the gateway notice if there is one."""
    deadline = time.monotonic() + deadline_s
    clicked = False
    while time.monotonic() < deadline:
        app = claude()
        if app is not None:
            everything = list(nodes(app))
            if any(role(n) == "entry" and PROMPT in text(n).lower() for n in everything):
                return everything
            notice = any(GATEWAY_NOTICE in text(n).lower() for n in everything)
            if notice and not clicked:
                clicked = press(button(everything, "Continue"))
        time.sleep(1)
    return None


def open_url(url):
    subprocess.run([OPEN_URL, url], timeout=30, check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def start_task(prompt):
    open_url("claude://claude.ai/new?q=" + quote(prompt, safe=""))
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        app = claude()
        if app is not None and press(button(list(nodes(app)), "Start task")):
            return True
        time.sleep(1)
    return False


def vm_log_since(offset):
    if not VM_LOG.exists():
        return b""
    with VM_LOG.open("rb") as log:
        log.seek(offset)
        return log.read()


# What Cowork logs once a VM startup has completed: the SDK installed and
# the keepalive started.
STARTUP_COMPLETE = (b"[Keepalive] Starting", b"sdk_install completed")
# A startup that failed, and a task that found the VM connected but
# couldn't install the SDK in it ("already-connected fast path").
STARTUP_FAILED = (b"Startup failed", b"Post-connect setup failed")


def last_line(log):
    lines = [line for line in log.splitlines() if line.strip()]
    return lines[-1].decode("utf-8", "replace").strip()[:200] if lines else ""


def log_size():
    return VM_LOG.stat().st_size if VM_LOG.exists() else 0


def last_failure(log):
    return max(log.rfind(marker) for marker in STARTUP_FAILED)


def vm_ready(log):
    """A startup completed after the last one that failed."""
    failed = last_failure(log)
    return any(log.rfind(marker) > failed for marker in STARTUP_COMPLETE)


def warm_vm():
    """Starts warm-up tasks until a Cowork VM startup completes."""
    deadline = time.monotonic() + WARM_DEADLINE_S
    # The guest can become ready between two warm-up tasks, so readiness is
    # read from everything logged since the warm-up began.
    began = log_size()
    while time.monotonic() < deadline:
        offset = log_size()
        if not start_task("Reply with OK."):
            return "the warm-up task couldn't be started"
        size, grew = offset, time.monotonic()
        while time.monotonic() < deadline:
            seen = vm_log_since(offset)
            if vm_ready(vm_log_since(began)):
                open_url("claude://claude.ai/new")
                return None if wait_for_prompt(30) is not None else "no new task after the warm-up"
            # Claude gave up on this start; once it's done, start another
            # task, which boots the VM again (or finds it still booting).
            if b"Post-connect setup failed" in seen or (
                b"Startup failed" in seen
                and (
                    b"All files ready" in seen.split(b"Startup failed")[-1]
                    or b"Skipping auto-reinstall" in seen
                )
            ):
                time.sleep(3)
                break
            if log_size() != size:
                size, grew = log_size(), time.monotonic()
            elif time.monotonic() - grew > STALL_S:
                print(f"Cowork's VM log was silent for {STALL_S} s; starting another warm-up task",
                      file=sys.stderr)
                break
            time.sleep(2)
    last = last_line(vm_log_since(began))
    return f"Cowork's VM wasn't ready within {WARM_DEADLINE_S} s" + (
        f" (its log last said: {last})" if last else " (its log said nothing)")


if wait_for_prompt(DEADLINE_S) is None:
    print(f"Cowork's prompt didn't appear within {DEADLINE_S} s", file=sys.stderr)
    sys.exit(1)
if os.environ.get("MST_COWORK_WARM_VM", "1") != "0":
    problem = warm_vm()
    if problem:
        print(problem, file=sys.stderr)
        sys.exit(1)
sys.exit(0)
