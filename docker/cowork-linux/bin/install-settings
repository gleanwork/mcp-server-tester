#!/bin/sh
# Run as root (`sudo -n`, the desktop user's only sudo rule). Claude Desktop
# reads /etc/claude-desktop/managed-settings.json only when root owns it and
# no one else can write it, so MST writes its settings to a staging file
# (MST_COWORK_SETTINGS_FILE) and this installs a root-owned copy.
set -eu
staging=/run/mst/settings/managed-settings.json
target=/etc/claude-desktop/managed-settings.json

[ -f "${staging}" ] && [ ! -L "${staging}" ] || { echo "no staged settings" >&2; exit 1; }
[ "$(stat -c %s "${staging}")" -le 1048576 ] || { echo "staged settings too large" >&2; exit 1; }
# Exit without printing the parse error: it quotes the settings' text.
node -e 'try { JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")) } catch { process.exit(1) }' "${staging}" \
  || { echo "staged settings aren't JSON" >&2; exit 1; }
install -o root -g root -m 0644 "${staging}" "${target}.new"
mv -f "${target}.new" "${target}"
