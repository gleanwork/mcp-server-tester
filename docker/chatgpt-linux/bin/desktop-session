#!/bin/bash
# The container's main process. As root, it makes the desktop user's private
# directories on the tmpfs; as that user, it starts the X server, the session
# bus, AT-SPI and an unlocked keyring, then waits. It doesn't start ChatGPT:
# MST's client starts the app for each session, with that session's profile.
#
# `desktop-session --dirs-only` (as root) only makes the private directories
# and exits: a grade container has no desktop, but its worker's HOME and
# TMPDIR (the image's ENV) are on the same tmpfs.
set -euo pipefail

if [[ "$(id -u)" == 0 ]]; then
  install -d -o mst -g mst -m 0755 /run/mst
  for dir in session tokens home tmp evidence; do
    install -d -o mst -g mst -m 0700 "/run/mst/${dir}"
  done
  [[ "${1:-}" == --dirs-only ]] && exit 0
  exec setpriv --reuid=mst --regid=mst --init-groups --reset-env \
    env PATH="${PATH}" HOME="${HOME}" USER=mst LANG="${LANG}" \
    DISPLAY="${DISPLAY}" DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" GNOME_KEYRING_CONTROL="${GNOME_KEYRING_CONTROL}" \
    AT_SPI_BUS_ADDRESS="${AT_SPI_BUS_ADDRESS}" \
    "$0"
fi

log=/run/mst/session
Xvfb "${DISPLAY}" -screen 0 1440x900x24 -nolisten tcp > "${log}/xvfb.log" 2>&1 &
xvfb=$!
for _ in $(seq 50); do
  [[ -S "/tmp/.X11-unix/X${DISPLAY#:}" ]] && break
  sleep 0.1
done

dbus-daemon --session --address="${DBUS_SESSION_BUS_ADDRESS}" --nofork \
  > "${log}/dbus.log" 2>&1 &
for _ in $(seq 50); do
  [[ -S "${DBUS_SESSION_BUS_ADDRESS#unix:path=}" ]] && break
  sleep 0.1
done

# Accessibility on, so Chromium exposes its tree to AT-SPI. The bus listens
# at $XDG_RUNTIME_DIR/at-spi/bus_<display>, which the image's ENV names.
/usr/libexec/at-spi-bus-launcher --launch-immediately > "${log}/at-spi.log" 2>&1 &
gdbus call --session --dest org.a11y.Bus --object-path /org/a11y/bus \
  --method org.freedesktop.DBus.Properties.Set org.a11y.Status IsEnabled '<true>' \
  > /dev/null 2>&1 || true
a11y="${AT_SPI_BUS_ADDRESS#unix:path=}"
for _ in $(seq 50); do
  [[ -S "${a11y}" ]] && break
  sleep 0.1
done

# A login keyring with an empty password, unlocked before anything asks for
# one. Otherwise the app waits on a password prompt and never shows a window.
if printf '\n' | gnome-keyring-daemon --unlock --components=secrets \
    --control-directory="${GNOME_KEYRING_CONTROL}" > "${log}/keyring.log" 2>&1 \
  && [[ -S "${DBUS_SESSION_BUS_ADDRESS#unix:path=}" ]] && [[ -S "${a11y}" ]]; then
  touch "${log}/ready"
else
  echo "the desktop session (X, D-Bus, AT-SPI or the keyring) didn't start" > "${log}/restart.log"
  touch "${log}/failed"
fi
wait "${xvfb}"
