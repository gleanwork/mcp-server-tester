{
  "name": "file-ops",
  "cases": [
    {
      "id": "read-config",
      "toolName": "read_file",
      "args": {
        "path": "/tmp/config.json"
      },
      "assertions": {
        "schema": "file-content",
        "containsText": ["version", "name"]
      }
    },
    {
      "id": "read-readme",
      "toolName": "read_file",
      "args": {
        "path": "/tmp/README.md"
      },
      "assertions": {
        "snapshot": "readme-snapshot"
      }
    }
  ]
}
