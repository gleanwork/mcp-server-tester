{
  "$id": "https://unpkg.com/@gleanwork/mcp-server-tester/schema/run/v1/trial.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "format": { "type": "string", "const": "mst.run/v1" },
    "kind": { "type": "string", "const": "trial" },
    "runId": { "type": "string" },
    "variant": { "type": "string" },
    "caseId": { "type": "string" },
    "datasetName": { "type": "string" },
    "trial": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "durationMs": { "type": "number" },
    "ending": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "kind": { "type": "string", "const": "trial" } },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "infrastructure" },
            "broke": {
              "type": "string",
              "enum": [
                "client-app",
                "workspace",
                "network",
                "provider",
                "collection",
                "deadline",
                "setup"
              ]
            },
            "retryable": { "type": "boolean" },
            "reason": { "type": "string" }
          },
          "required": ["kind", "broke", "retryable", "reason"],
          "additionalProperties": false
        }
      ]
    },
    "infrastructureError": { "type": "boolean" },
    "error": { "type": "string" },
    "gradingError": { "type": "string" },
    "trace": { "type": "object", "properties": {}, "additionalProperties": {} },
    "artifacts": { "type": "string" }
  },
  "required": [
    "format",
    "kind",
    "runId",
    "variant",
    "caseId",
    "datasetName",
    "trial",
    "durationMs",
    "infrastructureError"
  ],
  "additionalProperties": {}
}
