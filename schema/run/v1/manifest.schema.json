{
  "$id": "https://unpkg.com/@gleanwork/mcp-server-tester@2/schema/run/v1/manifest.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "format": { "type": "number", "const": 1 },
    "kind": { "type": "string", "const": "manifest" },
    "runId": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "required": ["path", "bytes", "sha256"],
        "additionalProperties": {}
      }
    }
  },
  "required": ["format", "runId", "files"],
  "additionalProperties": {}
}
