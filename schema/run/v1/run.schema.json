{
  "$id": "https://unpkg.com/@gleanwork/mcp-server-tester/schema/run/v1/run.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "format": { "type": "string", "const": "mst.run/v1" },
    "kind": { "type": "string", "const": "run" },
    "runId": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}Z-[0-9a-f]{6}(\\.g\\d+)?$"
    },
    "evalName": { "type": "string" },
    "configId": { "type": "string" },
    "contentHash": { "type": "string" },
    "createdAt": { "type": "string" },
    "finishedAt": { "type": "string" },
    "mst": {
      "type": "object",
      "properties": { "version": { "type": "string" } },
      "required": ["version"],
      "additionalProperties": {}
    },
    "baseline": { "type": "string" },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "servers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": {}
            }
          },
          "client": { "type": "string" },
          "model": { "type": "string" }
        },
        "required": ["name"],
        "additionalProperties": {}
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "caseCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "contentHash": { "type": "string" }
        },
        "required": ["name", "caseCount", "contentHash"],
        "additionalProperties": {}
      }
    },
    "judges": { "type": "array", "items": {} },
    "partial": { "type": "boolean" },
    "selection": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "redactStoredResponses": { "type": "boolean" },
    "environment": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "phases": {
      "type": "object",
      "properties": {
        "collect": {
          "type": "string",
          "enum": ["complete", "partial", "skipped", "failed"]
        },
        "grade": {
          "type": "string",
          "enum": ["complete", "partial", "skipped", "failed"]
        }
      },
      "required": ["collect", "grade"],
      "additionalProperties": {}
    }
  },
  "required": [
    "format",
    "kind",
    "runId",
    "evalName",
    "configId",
    "contentHash",
    "createdAt",
    "finishedAt",
    "mst",
    "variants",
    "datasets",
    "partial",
    "redactStoredResponses",
    "environment",
    "phases"
  ],
  "additionalProperties": {}
}
