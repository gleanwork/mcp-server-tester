{
  "$id": "https://unpkg.com/@gleanwork/mcp-server-tester/schema/run/v1/results.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "format": { "type": "string", "const": "mst.run/v1" },
    "kind": { "type": "string", "const": "results" },
    "runId": { "type": "string" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "datasetName": { "type": "string" },
          "variant": { "type": "string" },
          "pass": { "type": "boolean" },
          "durationMs": { "type": "number" },
          "ending": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "trial" }
                },
                "required": ["kind"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "infrastructure" },
                  "broke": {
                    "type": "string",
                    "enum": [
                      "client-app",
                      "workspace",
                      "network",
                      "provider",
                      "collection",
                      "deadline",
                      "setup"
                    ]
                  },
                  "retryable": { "type": "boolean" },
                  "reason": { "type": "string" }
                },
                "required": ["kind", "broke", "retryable", "reason"],
                "additionalProperties": {}
              }
            ]
          },
          "scores": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "pass": { "type": "boolean" },
                "score": { "type": "number" },
                "reasoning": { "type": "string" }
              },
              "required": ["pass"],
              "additionalProperties": {}
            }
          },
          "error": { "type": "string" },
          "gradingError": { "type": "string" },
          "passRate": { "type": "number" },
          "trialResults": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pass": { "type": "boolean" },
                "durationMs": { "type": "number" },
                "scores": {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "pass": { "type": "boolean" },
                      "score": { "type": "number" },
                      "reasoning": { "type": "string" }
                    },
                    "required": ["pass"],
                    "additionalProperties": {}
                  }
                },
                "error": { "type": "string" },
                "gradingError": { "type": "string" },
                "ending": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": { "type": "string", "const": "trial" }
                      },
                      "required": ["kind"],
                      "additionalProperties": {}
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": { "type": "string", "const": "infrastructure" },
                        "broke": {
                          "type": "string",
                          "enum": [
                            "client-app",
                            "workspace",
                            "network",
                            "provider",
                            "collection",
                            "deadline",
                            "setup"
                          ]
                        },
                        "retryable": { "type": "boolean" },
                        "reason": { "type": "string" }
                      },
                      "required": ["kind", "broke", "retryable", "reason"],
                      "additionalProperties": {}
                    }
                  ]
                },
                "transcript": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "tool_call",
                              "skill",
                              "command",
                              "subagent",
                              "tool_search"
                            ]
                          },
                          "source": {
                            "type": "string",
                            "enum": ["mcp", "builtin"]
                          },
                          "name": { "type": "string" },
                          "server": { "type": "string" },
                          "arguments": {
                            "type": "object",
                            "properties": {},
                            "additionalProperties": {}
                          },
                          "output": { "type": "string" },
                          "isError": { "type": "boolean" },
                          "id": { "type": "string" },
                          "durationMs": { "type": "number" }
                        },
                        "required": ["kind", "name"],
                        "additionalProperties": {}
                      }
                    },
                    "finalText": { "type": "string" },
                    "modelCalls": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": {}
                      }
                    },
                    "usage": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": {}
                    },
                    "hostTelemetry": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": {}
                    },
                    "evidence": {
                      "type": "string",
                      "enum": ["structured", "observed", "none"]
                    },
                    "startedAt": { "type": "string" },
                    "completedAt": { "type": "string" },
                    "error": { "type": "string" }
                  },
                  "required": ["events"],
                  "additionalProperties": {}
                },
                "writeRecord": {
                  "type": "object",
                  "properties": {
                    "writes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "server": { "type": "string" },
                          "tool": { "type": "string" },
                          "arguments": {},
                          "reply": {},
                          "mode": {
                            "type": "string",
                            "enum": ["planned", "simulated", "server-planned"]
                          },
                          "target": { "type": "string" },
                          "eventId": { "type": "string" }
                        },
                        "required": ["server", "tool", "arguments", "mode"],
                        "additionalProperties": {}
                      }
                    },
                    "unreported": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "unrecorded": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "server": { "type": "string" },
                          "tool": { "type": "string" },
                          "eventId": { "type": "string" }
                        },
                        "required": ["server", "tool"],
                        "additionalProperties": {}
                      }
                    },
                    "unclassified": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "server": { "type": "string" },
                          "tool": { "type": "string" },
                          "arguments": {},
                          "target": { "type": "string" },
                          "reason": {
                            "type": "string",
                            "enum": ["dispatch", "unmarked"]
                          }
                        },
                        "required": ["server", "tool", "arguments", "reason"],
                        "additionalProperties": {}
                      }
                    },
                    "attribution": {
                      "type": "string",
                      "enum": ["exclusive", "matched"]
                    }
                  },
                  "required": [
                    "writes",
                    "unreported",
                    "unrecorded",
                    "unclassified",
                    "attribution"
                  ],
                  "additionalProperties": {}
                }
              },
              "required": ["pass", "durationMs"],
              "additionalProperties": {}
            }
          },
          "transcript": {
            "type": "object",
            "properties": {
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "tool_call",
                        "skill",
                        "command",
                        "subagent",
                        "tool_search"
                      ]
                    },
                    "source": { "type": "string", "enum": ["mcp", "builtin"] },
                    "name": { "type": "string" },
                    "server": { "type": "string" },
                    "arguments": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": {}
                    },
                    "output": { "type": "string" },
                    "isError": { "type": "boolean" },
                    "id": { "type": "string" },
                    "durationMs": { "type": "number" }
                  },
                  "required": ["kind", "name"],
                  "additionalProperties": {}
                }
              },
              "finalText": { "type": "string" },
              "modelCalls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {}
                }
              },
              "usage": {
                "type": "object",
                "properties": {},
                "additionalProperties": {}
              },
              "hostTelemetry": {
                "type": "object",
                "properties": {},
                "additionalProperties": {}
              },
              "evidence": {
                "type": "string",
                "enum": ["structured", "observed", "none"]
              },
              "startedAt": { "type": "string" },
              "completedAt": { "type": "string" },
              "error": { "type": "string" }
            },
            "required": ["events"],
            "additionalProperties": {}
          },
          "writeRecord": {
            "type": "object",
            "properties": {
              "writes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "server": { "type": "string" },
                    "tool": { "type": "string" },
                    "arguments": {},
                    "reply": {},
                    "mode": {
                      "type": "string",
                      "enum": ["planned", "simulated", "server-planned"]
                    },
                    "target": { "type": "string" },
                    "eventId": { "type": "string" }
                  },
                  "required": ["server", "tool", "arguments", "mode"],
                  "additionalProperties": {}
                }
              },
              "unreported": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "unrecorded": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "server": { "type": "string" },
                    "tool": { "type": "string" },
                    "eventId": { "type": "string" }
                  },
                  "required": ["server", "tool"],
                  "additionalProperties": {}
                }
              },
              "unclassified": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "server": { "type": "string" },
                    "tool": { "type": "string" },
                    "arguments": {},
                    "target": { "type": "string" },
                    "reason": {
                      "type": "string",
                      "enum": ["dispatch", "unmarked"]
                    }
                  },
                  "required": ["server", "tool", "arguments", "reason"],
                  "additionalProperties": {}
                }
              },
              "attribution": {
                "type": "string",
                "enum": ["exclusive", "matched"]
              }
            },
            "required": [
              "writes",
              "unreported",
              "unrecorded",
              "unclassified",
              "attribution"
            ],
            "additionalProperties": {}
          },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "datasetName", "pass", "durationMs", "scores"],
        "additionalProperties": {}
      }
    }
  },
  "required": ["format", "kind", "runId", "cases"],
  "additionalProperties": {}
}
