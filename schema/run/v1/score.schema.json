{
  "$id": "https://unpkg.com/@gleanwork/mcp-server-tester/schema/run/v1/score.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "format": { "type": "string", "const": "mst.run/v1" },
    "kind": { "type": "string", "const": "score" },
    "runId": { "type": "string" },
    "grader": { "type": "string" },
    "variant": { "type": "string" },
    "caseId": { "type": "string" },
    "trial": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "score": {
      "type": "object",
      "properties": { "pass": { "type": "boolean" } },
      "required": ["pass"],
      "additionalProperties": {}
    }
  },
  "required": [
    "format",
    "kind",
    "runId",
    "grader",
    "variant",
    "caseId",
    "trial",
    "score"
  ],
  "additionalProperties": {}
}
