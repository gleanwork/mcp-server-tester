{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gleanwork/mcp-server-tester/schema/eval-manifest.schema.json",
  "title": "MCP evaluation manifest",
  "description": "Organization-neutral evaluation manifest. Pluggable blocks resolve through the tester registries.",
  "type": "object",
  "required": ["name", "datasets"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "description": "Shorthand for a file dataset." },
          {
            "type": "object",
            "required": ["type"],
            "additionalProperties": true,
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "path": { "type": "string" },
              "recursive": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "servers": {
      "type": "array",
      "description": "The MCP server set under test. Each entry is an MCPConfig.",
      "items": { "$ref": "#/definitions/mcpConfig" }
    },
    "host": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": { "type": { "type": "string", "minLength": 1 } }
    },
    "toolMap": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "toolOverrides": { "$ref": "#/definitions/toolOverrideVariant" },
    "scenarioTemplate": { "type": "string" },
    "arms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "servers": { "$ref": "#/properties/servers" },
          "host": {
            "type": "object",
            "description": "Partial patch to the base host. The effective host must have a type.",
            "additionalProperties": true,
            "properties": { "type": { "type": "string", "minLength": 1 } }
          },
          "toolMap": { "$ref": "#/properties/toolMap" },
          "toolOverrides": { "$ref": "#/definitions/toolOverrideVariant" },
          "scenarioTemplate": { "type": "string" },
          "metrics": {
            "type": "array",
            "items": { "$ref": "#/definitions/extension" }
          },
          "judges": {
            "type": "array",
            "items": { "$ref": "#/definitions/extension" }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": { "$ref": "#/definitions/extension" }
    },
    "judges": {
      "type": "array",
      "items": { "$ref": "#/definitions/extension" }
    },
    "results": {
      "type": "object",
      "required": ["store"],
      "properties": { "store": { "$ref": "#/definitions/extension" } },
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "model": { "type": "string" },
    "provider": { "type": "string" },
    "concurrency": { "type": "integer", "minimum": 1 },
    "iterations": { "type": "integer", "minimum": 1 },
    "maxCases": { "type": "integer", "minimum": 1 },
    "timeout": { "type": "integer", "minimum": 1 },
    "maxToolCalls": { "type": "integer", "minimum": 0 },
    "tools": { "type": "string" },
    "requireEvalEndpoint": { "type": "boolean" }
  },
  "definitions": {
    "mcpConfig": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "transport": { "type": "string", "const": "stdio" },
            "label": { "type": "string", "minLength": 1 },
            "command": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string" },
            "env": {
              "type": "object",
              "propertyNames": { "type": "string" },
              "additionalProperties": { "type": "string" }
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "sampling": {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": {}
                },
                "roots": {
                  "type": "object",
                  "properties": { "listChanged": { "type": "boolean" } },
                  "required": ["listChanged"]
                }
              }
            },
            "connectTimeoutMs": { "type": "number", "exclusiveMinimum": 0 },
            "requestTimeoutMs": { "type": "number", "exclusiveMinimum": 0 },
            "callTimeoutMs": { "type": "number", "exclusiveMinimum": 0 },
            "quiet": { "type": "boolean" }
          },
          "required": ["transport", "command"]
        },
        {
          "type": "object",
          "properties": {
            "transport": { "type": "string", "const": "http" },
            "label": { "type": "string", "minLength": 1 },
            "serverUrl": { "type": "string", "format": "uri" },
            "headers": {
              "type": "object",
              "propertyNames": { "type": "string" },
              "additionalProperties": { "type": "string" }
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "sampling": {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": {}
                },
                "roots": {
                  "type": "object",
                  "properties": { "listChanged": { "type": "boolean" } },
                  "required": ["listChanged"]
                }
              }
            },
            "connectTimeoutMs": { "type": "number", "exclusiveMinimum": 0 },
            "requestTimeoutMs": { "type": "number", "exclusiveMinimum": 0 },
            "callTimeoutMs": { "type": "number", "exclusiveMinimum": 0 },
            "auth": {
              "type": "object",
              "properties": {
                "accessToken": { "type": "string" },
                "oauth": {
                  "type": "object",
                  "properties": {
                    "serverUrl": { "type": "string", "format": "uri" },
                    "scopes": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "resource": { "type": "string", "format": "uri" },
                    "authStatePath": { "type": "string" },
                    "clientId": { "type": "string" },
                    "clientSecret": { "type": "string" },
                    "redirectUri": { "type": "string", "format": "uri" }
                  },
                  "required": ["serverUrl"]
                },
                "clientCredentials": {
                  "type": "object",
                  "properties": {
                    "clientId": { "type": "string" },
                    "clientSecret": { "type": "string" },
                    "tokenEndpoint": { "type": "string", "format": "uri" },
                    "scopes": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            },
            "proxy": {
              "type": "object",
              "properties": { "url": { "type": "string", "format": "uri" } },
              "required": ["url"]
            },
            "retryAttempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tls": {
              "type": "object",
              "properties": {
                "ca": { "type": "string" },
                "cert": { "type": "string" },
                "key": { "type": "string" },
                "rejectUnauthorized": { "type": "boolean" }
              }
            }
          },
          "required": ["transport", "serverUrl"]
        }
      ]
    },
    "toolOverrideVariant": {
      "type": "object",
      "required": ["id", "tools"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": { "type": "string" },
              "inputSchema": { "type": "object", "additionalProperties": true }
            }
          }
        }
      }
    },
    "extension": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": true,
          "properties": { "type": { "type": "string", "minLength": 1 } }
        }
      ]
    }
  }
}
