{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gleanwork/mcp-server-tester/schema/eval-manifest.schema.json",
  "title": "MCP evaluation manifest",
  "description": "Organization-neutral evaluation manifest. Pluggable blocks resolve through the tester registries.",
  "type": "object",
  "required": ["name", "datasets"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The editor schema this file points to."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Shorthand for a file dataset."
          },
          {
            "type": "object",
            "required": ["type"],
            "additionalProperties": true,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              },
              "recursive": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "servers": {
      "type": "array",
      "description": "The MCP server set under test. Each entry is an MCPConfig.",
      "items": {
        "$ref": "#/definitions/mcpConfig"
      }
    },
    "client": {
      "type": "string",
      "minLength": 1,
      "description": "The client under test: mst, claude-code, cowork, chatgpt, or a plugin's namespace/name. Default: claude-code."
    },
    "clientOptions": {
      "type": "object",
      "additionalProperties": true,
      "description": "The client's own options. Name the client with client and set the model with model, not here.",
      "not": {
        "anyOf": [
          {
            "required": ["type"]
          },
          {
            "required": ["client"]
          },
          {
            "required": ["model"]
          }
        ]
      }
    },
    "toolMap": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "toolOverrides": {
      "$ref": "#/definitions/toolOverrideVariant"
    },
    "inputTemplate": {
      "type": "string",
      "description": "Wraps each case's input before the host sees it: `{{input}}` is replaced by the input."
    },
    "arms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "servers": {
            "$ref": "#/properties/servers"
          },
          "client": {
            "type": "string",
            "minLength": 1,
            "description": "This arm's client. A different client doesn't inherit the manifest's clientOptions."
          },
          "model": {
            "type": "string",
            "description": "The model this arm's client uses."
          },
          "clientOptions": {
            "type": "object",
            "additionalProperties": true,
            "description": "The client's own options. Name the client with client and set the model with model, not here.",
            "not": {
              "anyOf": [
                {
                  "required": ["type"]
                },
                {
                  "required": ["client"]
                },
                {
                  "required": ["model"]
                }
              ]
            }
          },
          "toolMap": {
            "$ref": "#/properties/toolMap"
          },
          "toolOverrides": {
            "$ref": "#/definitions/toolOverrideVariant"
          },
          "inputTemplate": {
            "type": "string",
            "description": "This arm's input template: `{{input}}` is replaced by the case's input."
          },
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/extension"
            }
          },
          "judges": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/extension"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/extension"
      }
    },
    "judges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/extension"
      }
    },
    "results": {
      "type": "object",
      "required": ["store"],
      "properties": {
        "store": {
          "$ref": "#/definitions/extension"
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model": {
      "type": "string",
      "description": "The model the client uses: a default for every arm and case."
    },
    "provider": {
      "type": "string"
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "trials": {
      "type": "integer",
      "minimum": 1,
      "description": "Default number of trials per host case; cases may set their own."
    },
    "maxCases": {
      "type": "integer",
      "minimum": 1
    },
    "timeout": {
      "type": "integer",
      "minimum": 1
    },
    "maxToolCalls": {
      "type": "integer",
      "minimum": 0
    },
    "tools": {
      "type": "string"
    },
    "requireEvalEndpoint": {
      "type": "boolean"
    },
    "passThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Default share of a host case's trials that must pass; cases may set their own."
    },
    "filterTags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Run only cases with one of these tags."
    },
    "run": {
      "type": "object",
      "description": "The run controls, grouped: trials, maxCases, concurrency, filterTags, passThreshold.",
      "additionalProperties": false,
      "properties": {
        "trials": {
          "type": "integer",
          "minimum": 1,
          "description": "Default number of trials per host case."
        },
        "maxCases": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "filterTags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "passThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Default share of a host case's trials that must pass."
        }
      }
    },
    "temperature": {
      "type": "number",
      "description": "Generation default for API hosts."
    },
    "maxTokens": {
      "type": "number",
      "description": "Generation default for API hosts."
    },
    "redactStoredResponses": {
      "type": "boolean",
      "description": "Omit raw responses and trace text from stored results (default true)."
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Shared configs (namespace/name) from listed plugins, applied in order under the manifest."
    },
    "coworkSetup": {
      "type": "object",
      "description": "Cowork desktop setup; see docs/cowork.md."
    },
    "pricing": {
      "type": "object",
      "description": "USD per million tokens, by model, for hosts that report tokens but not cost.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "output"],
        "properties": {
          "input": {
            "type": "number",
            "minimum": 0
          },
          "output": {
            "type": "number",
            "minimum": 0
          },
          "cacheRead": {
            "type": "number",
            "minimum": 0
          },
          "cacheWrite": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "definitions": {
    "mcpConfig": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "transport": {
              "type": "string",
              "const": "stdio"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cwd": {
              "type": "string"
            },
            "env": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "sampling": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "roots": {
                  "type": "object",
                  "properties": {
                    "listChanged": {
                      "type": "boolean"
                    }
                  },
                  "required": ["listChanged"]
                }
              }
            },
            "protocol": {
              "type": "string",
              "pattern": "^(legacy|auto|\\d{4}-\\d{2}-\\d{2})$",
              "description": "MCP protocol: 'legacy' (default, initialize handshake), 'auto' (probe with server/discover, fall back to legacy), or a revision to pin such as '2025-06-18' or '2026-07-28'."
            },
            "protocolProbe": {
              "type": "object",
              "properties": {
                "timeoutMs": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "connectTimeoutMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "requestTimeoutMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "callTimeoutMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "quiet": {
              "type": "boolean"
            },
            "inheritEnv": {
              "type": "boolean"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "auth": {
              "type": "object",
              "properties": {
                "accessTokenEnv": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "required": ["accessTokenEnv"],
              "additionalProperties": false
            },
            "minTools": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "files": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": ["transport", "command"]
        },
        {
          "type": "object",
          "properties": {
            "transport": {
              "type": "string",
              "const": "http"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "serverUrl": {
              "type": "string",
              "format": "uri"
            },
            "headers": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "sampling": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "roots": {
                  "type": "object",
                  "properties": {
                    "listChanged": {
                      "type": "boolean"
                    }
                  },
                  "required": ["listChanged"]
                }
              }
            },
            "protocol": {
              "type": "string",
              "pattern": "^(legacy|auto|\\d{4}-\\d{2}-\\d{2})$",
              "description": "MCP protocol: 'legacy' (default, initialize handshake), 'auto' (probe with server/discover, fall back to legacy), or a revision to pin such as '2025-06-18' or '2026-07-28'."
            },
            "protocolProbe": {
              "type": "object",
              "properties": {
                "timeoutMs": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "connectTimeoutMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "requestTimeoutMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "callTimeoutMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "auth": {
              "type": "object",
              "properties": {
                "accessToken": {
                  "type": "string"
                },
                "accessTokenEnv": {
                  "type": "string",
                  "minLength": 1
                },
                "oauth": {
                  "type": "object",
                  "properties": {
                    "serverUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "resource": {
                      "type": "string",
                      "format": "uri"
                    },
                    "authStatePath": {
                      "type": "string"
                    },
                    "clientId": {
                      "type": "string"
                    },
                    "clientSecret": {
                      "type": "string"
                    },
                    "redirectUri": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": ["serverUrl"]
                },
                "clientCredentials": {
                  "type": "object",
                  "properties": {
                    "clientId": {
                      "type": "string"
                    },
                    "clientSecret": {
                      "type": "string"
                    },
                    "tokenEndpoint": {
                      "type": "string",
                      "format": "uri"
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "proxy": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": ["url"]
            },
            "retryAttempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tls": {
              "type": "object",
              "properties": {
                "ca": {
                  "type": "string"
                },
                "cert": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "rejectUnauthorized": {
                  "type": "boolean"
                }
              }
            }
          },
          "required": ["transport", "serverUrl"]
        }
      ]
    },
    "toolOverrideVariant": {
      "type": "object",
      "required": ["id", "tools"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,128}$",
                "description": "Replacement tool name. Calls reach the original tool and are recorded under its original name."
              },
              "description": {
                "type": "string"
              },
              "inputSchema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "extension": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
