{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "docusaurus-2",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "cleanUrls": true,
  "git": { "deploymentEnabled": false },
  "rewrites": [{ "source": "/mcp", "destination": "/api/mcp" }],
  "redirects": [
    { "source": "/docs/design", "destination": "/docs/walkthrough" },
    { "source": "/docs/design/explainer", "destination": "/docs/architecture" },
    {
      "source": "/docs/design/auth-and-connectors",
      "destination": "/docs/connectors"
    },
    {
      "source": "/docs/design/chatgpt-docker",
      "destination": "/docs/chatgpt-docker"
    }
  ]
}
