{
  "name": "eval-enhancement-verification",
  "description": "Verifies trials, pass thresholds, concurrency and tool-call assertions end to end against the mock stdio server. tests/eval-verification.spec.ts runs the cases on a scripted client that calls the server's real tools.",
  "cases": [
    {
      "id": "multi-iter-echo-always-passes",
      "description": "3 trials, all pass. The echo tool answers 'Echo: hello'.",
      "input": "echo hello",
      "trials": 3,
      "passThreshold": 1.0,
      "assertions": {
        "containsText": "hello",
        "toolsTriggered": { "calls": [{ "name": "echo", "required": true }] }
      }
    },
    {
      "id": "multi-iter-calculate-addition",
      "description": "5 trials of a deterministic calculation (7+3=10).",
      "input": "add 7 3",
      "trials": 5,
      "passThreshold": 0.8,
      "assertions": {
        "containsText": "10",
        "toolsTriggered": {
          "calls": [
            {
              "name": "calculate",
              "arguments": { "operation": "add", "a": 7, "b": 3 },
              "required": true
            }
          ]
        },
        "toolCallCount": { "exact": 1 }
      }
    },
    {
      "id": "single-iter-baseline",
      "description": "One trial: no pass-rate fields expected.",
      "input": "echo baseline",
      "assertions": {
        "containsText": "baseline"
      }
    },
    {
      "id": "multi-iter-low-threshold",
      "description": "3 trials with a 50% threshold.",
      "input": "echo threshold-test",
      "trials": 3,
      "passThreshold": 0.5,
      "assertions": {
        "containsText": "threshold-test"
      }
    }
  ]
}
